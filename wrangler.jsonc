{
  "name": "getvini-erp",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "API_ORIGIN": "https://erp-sno3.onrender.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/socket.io/*"]
  }
}
