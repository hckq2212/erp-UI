{
  "name": "getvini-erp",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "VITE_API_URL": "https://erp-z63c.onrender.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/socket.io/*"
    ]
  }
}